# Public configuration only. Never commit signing keys or bid secrets.
CHAIN_ID=1301
RPC_URL=https://sepolia.unichain.org
# Testnet only. Set this locally; never commit it or send it in chat.
DEPLOYER_PRIVATE_KEY=
# Public address that must match DEPLOYER_PRIVATE_KEY. The script derives the proceeds recipient
# from the key and refuses to broadcast if the signer does not match this address.
DEPLOYER_ADDRESS=0x54560095593B57Ad71572336037435Ff1E50E4EA
# Uniswap's official Unichain Sepolia PoolManager as of 2026-09-07.
POOL_MANAGER=0x00b036b58a818b1bc34d502d3fe730db729e62ac
# Application-level surcharge in PPM; 500 = 5 basis points. Maximum is 10,000.
SURCHARGE_PPM=500

# Verified Kairos contracts on Unichain Sepolia. Bootstrap and scheduling scripts validate these.
PFDA_AUCTION=0xE30bd1162A9BB02C32EC8a0731014d45e1C15B73
PFDA_EXECUTOR=0x479E644B05876C6AD98cE59C2Fc94FB6C0E6b231
PFDA_HOOK=0xBeE0b2606fdb9b70Ca3FB24254B674423f1e40c8

# Set PFDA_POOL_ID only after BootstrapPFDAPool is broadcast and verified.
PFDA_POOL_ID=
# Optional scheduler settings, all measured from the scheduling block.
AUCTION_COMMIT_DELAY_SECONDS=300
AUCTION_COMMIT_DURATION_SECONDS=1200
AUCTION_REVEAL_DURATION_SECONDS=1200
AUCTION_ACTIVATION_DELAY_SECONDS=2100
AUCTION_RIGHT_DURATION_SECONDS=1800
AUCTION_BOND_USDC=1000000
AUCTION_MINIMUM_BID_USDC=10000000
